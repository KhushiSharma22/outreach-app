# Copy to .env and fill in. `npm start` loads .env automatically; never commit .env.

# --- Database (Supabase) -------------------------------------------------------
# Supabase dashboard → Connect → Session pooler (IPv4, port 5432). Replace [YOUR-PASSWORD].
# Leave unset to use the local SQLite file in data/.
DATABASE_URL=
# Supabase dashboard → Project Settings → Database → SSL configuration → Download certificate.
# With it, the server verifies it is talking to your Supabase database.
DATABASE_CA_CERT=
# On Vercel, paste the certificate's text here instead of a file path.
DATABASE_CA_CERT_PEM=
DATABASE_POOL_SIZE=10

# --- Public address -------------------------------------------------------------
PUBLIC_URL=http://127.0.0.1:4173

# --- Account emails (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Outbound <no-reply@yourdomain.com>

# --- Google sign-in -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel cron (any long random string; openssl rand -hex 32) ---------------
CRON_SECRET=

# --- AI (optional) --------------------------------------------------------------
# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=
# Or Claude instead (used first if set):
ANTHROPIC_API_KEY=

# Super admins get the in-app portal for approving people and operators. Leave unset to use the
# built-in list (khushi.sharma.2201@gmail.com, paroksh05@gmail.com, siddharth.m2703@gmail.com).
# SUPER_ADMIN_EMAILS=

# Private pilot: extra approved emails set in the deployment (most are added in the Super admin portal).
ALLOWED_EMAILS=

# Generate 32 random bytes encoded as base64; keep stable and secret.
MAILBOX_KEY=
# Exact SMTP hosts approved by the operator.
SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com

OPERATOR_EMAILS=

# Loopback development only; production ignores this flag.
LOCAL_SKIP_EMAIL_VERIFICATION=false
