# Copy to .env and fill in. `npm start` loads .env automatically; never commit .env.

# --- Database (Supabase) -------------------------------------------------------
# Supabase dashboard → Connect → Session pooler (IPv4, port 5432). Replace [YOUR-PASSWORD].
# Leave unset to use the local SQLite file in data/.
DATABASE_URL=
# Supabase dashboard → Project Settings → Database → SSL configuration → Download certificate.
# With it, the server verifies it is talking to your Supabase database.
DATABASE_CA_CERT=
# On Vercel, paste the certificate's text here instead of a file path.
DATABASE_CA_CERT_PEM=
DATABASE_POOL_SIZE=10

# --- Public address -------------------------------------------------------------
PUBLIC_URL=http://127.0.0.1:4173

# --- Account emails (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Outbound <no-reply@yourdomain.com>

# --- Google sign-in -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel cron (any long random string; openssl rand -hex 32) ---------------
CRON_SECRET=

# --- AI (optional) --------------------------------------------------------------
ANTHROPIC_API_KEY=
