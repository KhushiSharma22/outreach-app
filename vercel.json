{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    },
    "api/cron.mjs": {
      "maxDuration": 300
    },
    "api/weekly-cron.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!cron$|weekly-cron$|index$).*)",
      "destination": "/api/index?__path=api/:path"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index?__path=auth/:path*"
    },
    {
      "source": "/unsubscribe/:path*",
      "destination": "/api/index?__path=unsubscribe/:path*"
    },
    {
      "source": "/sample-contacts.csv",
      "destination": "/api/index?__path=sample-contacts.csv"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ],
  "schedules": {
    "weekly-smtp": {
      "schedule": "*/15 * * * *",
      "path": "/api/weekly-cron",
      "requestMethod": "GET"
    }
  }
}
